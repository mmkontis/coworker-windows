<Page
    x:Class="Coworker.Pages.DictionaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="14" Padding="24,16">
            <!-- Page Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <Border CornerRadius="12" Width="42" Height="42">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#332473F2" Offset="0" />
                                <GradientStop Color="#1F4DD9FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE82D;" FontSize="20"
                                  Foreground="{StaticResource CwAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Dictionary" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Custom words and replacements for cleaner dictation."
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="AddButton" Click="OnToggleAddForm">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="AddIcon" Glyph="&#xE710;" FontSize="12" />
                            <TextBlock x:Name="AddText" Text="Add Entry" FontSize="13"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnRefresh" ToolTipService.ToolTip="Sync dictionary">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search -->
            <Grid CornerRadius="10" Padding="12,10"
                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="0,0,8,0" />
                <TextBox Grid.Column="1" x:Name="SearchBox"
                         PlaceholderText="Search words, shortcuts…"
                         BorderThickness="0" Background="Transparent" FontSize="14"
                         TextChanged="OnSearchChanged" />
                <Button Grid.Column="2" x:Name="ClearSearch" Click="OnClearSearch"
                        Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE711;" FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Spacing="0" Padding="0,0,0,32" />
        </ScrollViewer>

        <!-- Add Form Overlay -->
        <Border x:Name="AddFormPanel" Grid.Row="2" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="24,20,24,0"
                CornerRadius="12" Padding="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="#402473F2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewWordBox" PlaceholderText="Word or phrase"
                         BorderThickness="0" Background="Transparent"
                         FontSize="14" Padding="14,12" />
                <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="12"
                          Foreground="#992473F2" Margin="0" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" x:Name="NewShortcutBox"
                         PlaceholderText="Replaces with…"
                         BorderThickness="0" Background="Transparent"
                         FontSize="14" Padding="14,12" />
                <Button Grid.Column="3" Click="OnSaveEntry" Margin="0,0,8,0"
                        VerticalAlignment="Center" Width="36" Height="36"
                        CornerRadius="18" Padding="0">
                    <Button.Background>
                        <SolidColorBrush Color="{StaticResource CwAccentColor}" />
                    </Button.Background>
                    <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="White" />
                </Button>
            </Grid>
        </Border>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Grid.Row="2"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed" Spacing="16">
            <FontIcon Glyph="&#xE82D;" FontSize="56"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="Your Dictionary is Empty" FontSize="20"
                       FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Add custom words and their replacements to improve&#x0a;transcription accuracy for your specific vocabulary."
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <Button Click="OnToggleAddForm" HorizontalAlignment="Center"
                    Padding="24,12" CornerRadius="10">
                <Button.Background>
                    <SolidColorBrush Color="{StaticResource CwAccentColor}" />
                </Button.Background>
                <TextBlock Text="Add First Entry" FontWeight="SemiBold" Foreground="White" />
            </Button>
        </StackPanel>

        <!-- Loading -->
        <StackPanel x:Name="LoadingState" Grid.Row="2"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed" Spacing="12">
            <ProgressRing IsActive="True" Width="32" Height="32" />
            <TextBlock Text="Loading dictionary..." FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
