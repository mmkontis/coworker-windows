<UserControl
    x:Class="Coworker.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mac LoginView: the gradient and the background image fill the whole window (ignoresSafeArea). -->
    <Grid Background="{StaticResource SidebarGradientBrush}">
            <Image Source="ms-appx:///Assets/sidebar-background.png" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="32">
                <Border Width="96" Height="96" CornerRadius="22" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/coworker-icon.png" Stretch="UniformToFill" />
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="Sign in to Coworker" FontSize="28" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="BodyText" FontSize="14" Foreground="#80FFFFFF" MaxWidth="340"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>

                <Grid HorizontalAlignment="Center">
                    <Border x:Name="ButtonShadow" />
                    <Button x:Name="GoogleSignInButton" Width="280" Padding="0,12" CornerRadius="10"
                            HorizontalContentAlignment="Center" Click="OnGoogleSignIn"
                            Background="White" BorderThickness="0" Foreground="#FF424242"
                            AutomationProperties.Name="Continue with Google" AutomationProperties.AutomationId="login-google">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="White" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF5F5F5" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFEBEBEB" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="#FF424242" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF424242" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF424242" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="G" FontSize="16" FontWeight="Bold" Foreground="#FF4285F4" />
                            <TextBlock Text="Continue with Google" FontSize="14" FontWeight="SemiBold" Foreground="#FF424242" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="Opens in your default browser and returns to Coworker automatically." FontSize="12"
                           Foreground="#59FFFFFF" MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,24">
                <HyperlinkButton x:Name="LearnMoreLink" Click="OnLearnMore" Padding="0" HorizontalAlignment="Center"
                                 AutomationProperties.Name="Learn more">
                    <HyperlinkButton.Resources>
                        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#73FFFFFF" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#B3FFFFFF" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#73FFFFFF" />
                    </HyperlinkButton.Resources>
                    <TextBlock Text="Learn more" FontSize="12" FontWeight="Medium" TextDecorations="Underline" />
                </HyperlinkButton>
                <TextBlock Text="By signing in, you agree to our Terms and Privacy Policy." FontSize="11" Foreground="#33FFFFFF"
                           TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>
    </Grid>
</UserControl>
