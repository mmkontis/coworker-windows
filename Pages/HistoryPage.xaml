<Page
    x:Class="Coworker.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="16" Padding="24,24,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="History" FontSize="32" FontWeight="Bold" />
                    <TextBlock Text="Your transcription history" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock x:Name="TranscriptionCount" Text="0" FontSize="20"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="Transcriptions" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock x:Name="WordCount" Text="0" FontSize="20"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="Words" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Click="OnRefresh" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </Grid>

            <!-- Search -->
            <Grid CornerRadius="12" Padding="16,12"
                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="0,0,12,0" />
                <TextBox Grid.Column="1" x:Name="SearchBox"
                         PlaceholderText="Search transcriptions..."
                         BorderThickness="0" Background="Transparent"
                         FontSize="16" TextChanged="OnSearchChanged" />
                <Button Grid.Column="2" x:Name="ClearSearch" Click="OnClearSearch"
                        Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE711;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Spacing="12" Padding="24,0,24,32" />
        </ScrollViewer>

        <!-- Loading -->
        <StackPanel x:Name="LoadingState" Grid.Row="2"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed" Spacing="12">
            <ProgressRing IsActive="True" Width="32" Height="32" />
            <TextBlock Text="Loading history..." FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Empty -->
        <StackPanel x:Name="EmptyState" Grid.Row="2"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed" Spacing="16">
            <FontIcon Glyph="&#xE81C;" FontSize="64"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Text="No Transcriptions Yet"
                       FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptySubtitle"
                       Text="Your transcription history will appear here.&#x0a;Start recording to create your first transcription."
                       FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Error -->
        <StackPanel x:Name="ErrorState" Grid.Row="2"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed" Spacing="16">
            <FontIcon Glyph="&#xE7BA;" FontSize="48"
                      Foreground="Orange" HorizontalAlignment="Center" />
            <TextBlock Text="Failed to Load History" FontSize="20"
                       FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorText" FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <Button Click="OnRefresh" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Retry" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
