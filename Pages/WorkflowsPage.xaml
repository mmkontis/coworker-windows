<Page
    x:Class="Coworker.Pages.WorkflowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <!-- Mac WorkflowWorkspaceView: a 44 high toolbar over the embedded editor, and an error overlay. -->
    <Grid AutomationProperties.AutomationId="workflow-workspace">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Height="44" Padding="20,0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Style="{StaticResource PopoverRowButtonStyle}" Width="28" Height="28" CornerRadius="6"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsEnabled="False" Click="OnBack"
                    ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource PopoverRowButtonStyle}" Width="28" Height="28"
                    CornerRadius="6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsEnabled="False" Click="OnForward"
                    ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PopoverRowButtonStyle}" Height="28" Padding="8,0" CornerRadius="6"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" Click="OnShowWorkflows" AutomationProperties.Name="Workflows">
                <TextBlock Text="Workflows" FontSize="13" FontWeight="Medium" />
            </Button>
            <ProgressRing x:Name="Spinner" Grid.Column="4" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
            <Button Grid.Column="5" Style="{StaticResource PopoverRowButtonStyle}" Width="28" Height="28" CornerRadius="6"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" Click="OnReload"
                    ToolTipService.ToolTip="Reload editor" AutomationProperties.Name="Reload editor">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button Grid.Column="6" Style="{StaticResource PopoverRowButtonStyle}" Width="28" Height="28" CornerRadius="6"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" Click="OnOpenInBrowser"
                    ToolTipService.ToolTip="Open in browser" AutomationProperties.Name="Open in browser">
                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
            </Button>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid x:Name="WebHost" Grid.Row="2">
            <Grid x:Name="ErrorPanel" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEB5E;" FontSize="26" HorizontalAlignment="Center" />
                    <TextBlock Text="Couldn’t load workflows" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" FontSize="14" MaxWidth="420" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Try again" HorizontalAlignment="Center" Click="OnReload" />
                    <HyperlinkButton x:Name="RuntimeLink" Content="Get the WebView2 Runtime" HorizontalAlignment="Center"
                                     Visibility="Collapsed" Click="OnGetRuntime" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
