<Page
    x:Class="Coworker.Pages.PlaybooksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Main content -->
        <ScrollViewer x:Name="MainContent" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" Padding="24,8,24,32">
                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="14" Width="48" Height="48"
                            Background="#192473F2" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="22"
                                  Foreground="{StaticResource CwAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Playbooks" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Prompt templates for quick actions"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="OnNewPlaybook"
                            VerticalAlignment="Center"
                            Background="{StaticResource CwAccentBrush}"
                            Foreground="White"
                            CornerRadius="10" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White" />
                            <TextBlock Text="New Playbook" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Search Bar -->
                <TextBox x:Name="SearchBox" PlaceholderText="Search playbooks..."
                         TextChanged="OnSearchChanged"
                         CornerRadius="12" Padding="12,10"
                         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- Playbooks Grid -->
                <ItemsRepeater x:Name="PlaybooksRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="300" MinItemHeight="180"
                                           ItemsStretch="Fill" MinColumnSpacing="16"
                                           MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="16" Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    PointerEntered="OnCardPointerEntered"
                                    PointerExited="OnCardPointerExited">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Title + Category -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="16"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" CornerRadius="8" Padding="8,4"
                                                Background="#192473F2">
                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource CwAccentBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Content Preview -->
                                    <TextBlock Grid.Row="1" Text="{Binding Content}"
                                               FontSize="13" MaxLines="3" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,8,0,0" />

                                    <!-- Footer: Date + Actions -->
                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FormattedDate}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                    x:Name="CardActions" Opacity="0">
                                            <Button Padding="6" Background="Transparent"
                                                    BorderThickness="0" CornerRadius="6"
                                                    Click="OnEditPlaybook" Tag="{Binding Id}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                            </Button>
                                            <Button Padding="6" Background="Transparent"
                                                    BorderThickness="0" CornerRadius="6"
                                                    Click="OnDeletePlaybook" Tag="{Binding Id}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13"
                                                          Foreground="#FFE74856" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Visibility="Visible"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="16">
            <Border CornerRadius="20" Width="72" Height="72"
                    Background="#192473F2" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="32"
                          Foreground="{StaticResource CwAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="No Playbooks Yet" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Create prompt templates to speed up your workflow"
                       FontSize="14" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Click="OnNewPlaybook" HorizontalAlignment="Center"
                    Background="{StaticResource CwAccentBrush}"
                    Foreground="White" CornerRadius="10" Padding="20,10"
                    Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White" />
                    <TextBlock Text="Create First Playbook" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- New/Edit Playbook Dialog Panel -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed"
              Background="#80000000">
            <Border CornerRadius="20" Padding="28" MaxWidth="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="20" MinWidth="420">
                    <TextBlock x:Name="DialogTitle" Text="New Playbook"
                               FontSize="20" FontWeight="Bold" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Title" FontSize="13" FontWeight="SemiBold" />
                        <TextBox x:Name="PlaybookTitleBox" PlaceholderText="e.g. Email Reply"
                                 CornerRadius="10" Padding="12,10" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Category" FontSize="13" FontWeight="SemiBold" />
                        <TextBox x:Name="PlaybookCategoryBox" PlaceholderText="e.g. Email, Writing, Code"
                                 CornerRadius="10" Padding="12,10" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Content" FontSize="13" FontWeight="SemiBold" />
                        <TextBox x:Name="PlaybookContentBox"
                                 PlaceholderText="Enter your prompt template..."
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="120" MaxHeight="200"
                                 CornerRadius="10" Padding="12,10" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Click="OnDialogCancel"
                                HorizontalAlignment="Stretch"
                                CornerRadius="10" Padding="0,10" />
                        <Button Grid.Column="1" Click="OnDialogSave"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource CwAccentBrush}"
                                Foreground="White" CornerRadius="10" Padding="0,10">
                            <TextBlock x:Name="DialogSaveText" Text="Create"
                                       FontWeight="SemiBold" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
