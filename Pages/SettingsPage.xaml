<Page
    x:Class="Coworker.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Coworker.Controls"
    xmlns:settings="using:Coworker.Settings">

    <Page.Resources>
        <!-- Switches on this page are filled with the brand accent instead of the system accent. -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource CwAccentColor}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource CwAccentColor}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource CwAccentColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource CwAccentColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource CwAccentColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource CwAccentColor}" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White" />
    </Page.Resources>

    <!-- Section order follows the Mac SettingsPageView: Permissions, Appearance, General, Voice
         Shortcuts, Clipboard History, OpenRouter, Model & Language, On-device Model (not ported),
         Audio Quality, Tools, App Actions, Diagnostics, About. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="24,24,24,16" Spacing="4">
            <TextBlock Text="Settings" FontSize="32" FontWeight="Bold"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="Configure your preferences" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="32">

                <!-- Permissions: Windows only gates the microphone; the Mac's Contacts, Accessibility
                     and Automation cards have no Windows counterpart. -->
                <settings:SettingsSection Title="Permissions">
                    <StackPanel Spacing="12">
                        <settings:PermissionCard x:Name="MicrophoneCard" Glyph="&#xE720;"
                                                 Title="Microphone Access"
                                                 Description="Required for voice transcription"
                                                 ActionRequested="OnMicrophoneAction" />
                    </StackPanel>
                </settings:SettingsSection>

                <settings:SettingsSection Title="Appearance">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                   Text="Choose how Coworker looks. Clean follows your Windows light/dark setting." />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="CleanThemeCard" GroupName="AppTheme" Tag="Clean"
                                         Style="{StaticResource SettingsOptionCardStyle}"
                                         Checked="OnThemeCardChecked" AutomationProperties.Name="Clean theme">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CleanTile" Width="34" Height="34" CornerRadius="9">
                                        <!-- circle.lefthalf.filled -->
                                        <Grid Width="18" Height="18">
                                            <Ellipse x:Name="CleanRing" Width="17" Height="17" StrokeThickness="1.6" />
                                            <Path x:Name="CleanHalf" Data="M9,1 A8,8 0 0 0 9,17 Z" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Clean" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Adapts to system light &amp; dark" FontSize="11" MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon x:Name="CleanCheck" Grid.Column="2" FontSize="16" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="AuroraThemeCard" Grid.Column="1" GroupName="AppTheme" Tag="Aurora"
                                         Style="{StaticResource SettingsOptionCardStyle}"
                                         Checked="OnThemeCardChecked" AutomationProperties.Name="Aurora theme">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AuroraTile" Width="34" Height="34" CornerRadius="9">
                                        <!-- sparkles: one large and two small four-point stars -->
                                        <Canvas Width="18" Height="18">
                                            <Path x:Name="AuroraStarLarge" Data="M0,-1 C0.15,-0.35 0.35,-0.15 1,0 C0.35,0.15 0.15,0.35 0,1 C-0.15,0.35 -0.35,0.15 -1,0 C-0.35,-0.15 -0.15,-0.35 0,-1 Z">
                                                <Path.RenderTransform>
                                                    <CompositeTransform ScaleX="6.5" ScaleY="6.5" TranslateX="7" TranslateY="11" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <Path x:Name="AuroraStarTop" Data="M0,-1 C0.15,-0.35 0.35,-0.15 1,0 C0.35,0.15 0.15,0.35 0,1 C-0.15,0.35 -0.35,0.15 -1,0 C-0.35,-0.15 -0.15,-0.35 0,-1 Z">
                                                <Path.RenderTransform>
                                                    <CompositeTransform ScaleX="3.2" ScaleY="3.2" TranslateX="14" TranslateY="4" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <Path x:Name="AuroraStarBottom" Data="M0,-1 C0.15,-0.35 0.35,-0.15 1,0 C0.35,0.15 0.15,0.35 0,1 C-0.15,0.35 -0.35,0.15 -1,0 C-0.35,-0.15 -0.15,-0.35 0,-1 Z">
                                                <Path.RenderTransform>
                                                    <CompositeTransform ScaleX="2.6" ScaleY="2.6" TranslateX="14.5" TranslateY="14.5" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Canvas>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Aurora" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Signature deep-blue gradient" FontSize="11" MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon x:Name="AuroraCheck" Grid.Column="2" FontSize="16" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </settings:SettingsSection>

                <!-- General: the Mac's Chat Mode and Functions switches belong to chat and are not ported. -->
                <settings:SettingsSection Title="General">
                    <StackPanel Spacing="16">
                        <settings:SettingsRow Title="Paste dictation into last focused input"
                                              Subtitle="Remember your last text field across windows and displays. When off, paste into the active app.">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.PasteToLastInput, Mode=TwoWay}"
                                                     AutomationProperties.Name="Paste dictation into last focused input" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Space after a sentence end"
                                              Subtitle="When the cursor sits right after . ! or ?, start the dictation with a space.">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.SpaceAfterSentenceEnd, Mode=TwoWay}"
                                                     AutomationProperties.Name="Space after a sentence end" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Translation" Subtitle="Translate transcribed text">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.TranslationEnabled, Mode=TwoWay}"
                                                     AutomationProperties.Name="Translation" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Translate to"
                                              Visibility="{x:Bind ViewModel.TranslationEnabled, Mode=OneWay}">
                            <ComboBox x:Name="TranslateToCombo" Width="200" DisplayMemberPath="Name"
                                      SelectedValuePath="Code" SelectionChanged="OnTranslateToChanged"
                                      AutomationProperties.Name="Translate to" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Privacy Mode" Subtitle="Hide sensitive information">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.PrivacyModeEnabled, Mode=TwoWay}"
                                                     AutomationProperties.Name="Privacy Mode" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Play a sound when dictation starts and stops">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.DictationSoundsEnabled, Mode=TwoWay}"
                                                     AutomationProperties.Name="Play a sound when dictation starts and stops" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Auto-start on Login">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.AutoStartEnabled, Mode=TwoWay}"
                                                     AutomationProperties.Name="Auto-start on Login" />
                        </settings:SettingsRow>
                    </StackPanel>
                </settings:SettingsSection>

                <!-- Dictionary: the words live on the server (/coworker/words) and are edited on the Dictionary page. -->
                <settings:SettingsSection Title="Dictionary">
                    <StackPanel Spacing="16">
                        <settings:SettingsRow Title="Dictionary"
                                              Subtitle="Names and words Coworker should spell right, and shortcuts that type longer text. Saved to your account and used in every dictation.">
                            <Button Content="Open Dictionary" Click="OnOpenDictionary"
                                    AutomationProperties.Name="Open Dictionary" />
                        </settings:SettingsRow>
                    </StackPanel>
                </settings:SettingsSection>

                <!-- Voice Shortcuts: the Mac's Chat Shortcut row belongs to chat and is not ported. -->
                <settings:SettingsSection Title="Voice Shortcuts">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                   Text="Hold a shortcut to record and release it to finish. Click the box, then either press a combo such as Ctrl + Shift + D, or hold modifiers on their own (Ctrl, Ctrl + Shift, Ctrl + Win) and let go." />
                        <settings:SettingsRow Title="Dictation Shortcut"
                                              Subtitle="Starts transcription while you hold the shortcut">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <settings:ShortcutRecorder x:Name="DictationRecorder" AllowModifierOnly="True"
                                                           AutomationProperties.Name="Dictation shortcut"
                                                           ShortcutRecorded="OnDictationShortcutRecorded" />
                                <Button Content="Use Ctrl + Shift" Click="OnUseDefaultDictationShortcut"
                                        Background="Transparent" BorderThickness="0" FontSize="12" FontWeight="Medium"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </settings:SettingsRow>
                        <Button Content="Reset to Ctrl + Shift Default" Click="OnUseDefaultDictationShortcut" />
                        <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                   Text="A single modifier (Ctrl or Alt alone) works too: a quick Ctrl + C still copies, only a hold starts dictation. The laptop Fn key can't be used: most keyboards never tell Windows about it." />
                    </StackPanel>
                </settings:SettingsSection>

                <settings:SettingsSection Title="Clipboard History">
                    <StackPanel Spacing="16">
                        <settings:SettingsRow Title="Enable Clipboard History"
                                              Subtitle="Store clipboard history locally on this PC only">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=TwoWay}"
                                                     AutomationProperties.Name="Enable Clipboard History" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Auto-paste"
                                              Subtitle="Paste the selected clipboard item into the previously active app">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.AutoPaste, Mode=TwoWay}"
                                                     AutomationProperties.Name="Auto-paste" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Auto-Enter after dictation"
                                              Subtitle="Automatically press Enter after Coworker pastes transcribed text in selected apps">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.AutoSubmitEnabled, Mode=TwoWay}"
                                                     AutomationProperties.Name="Auto-Enter after dictation" />
                        </settings:SettingsRow>

                        <StackPanel Spacing="10" Padding="0,4"
                                    Visibility="{x:Bind ViewModel.AutoSubmitEnabled, Mode=OneWay}">
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Auto-Enter apps" />
                                <TextBlock Style="{StaticResource SettingsRowSubtitleStyle}"
                                           Text="Select which apps should receive Enter after dictation paste — useful for chat and messaging apps." />
                            </StackPanel>
                            <Border x:Name="AutoEnterEmpty" CornerRadius="10" Padding="12"
                                    Background="{ThemeResource SettingsInsetFill}">
                                <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                           Text="Copy something in an app to make it appear here." />
                            </Border>
                            <StackPanel x:Name="AutoEnterAppsPanel" Spacing="8" />
                            <StackPanel x:Name="AutoEnterSitesBlock" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Sites" FontSize="13" FontWeight="Medium" Margin="0,4,0,0" />
                                <StackPanel x:Name="AutoEnterSitesPanel" Spacing="8" />
                            </StackPanel>
                        </StackPanel>

                        <settings:SettingsRow Title="Show Media Bar"
                                              Subtitle="Display recent files and images in a floating bar">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.ShowMediaBar, Mode=TwoWay}"
                                                     AutomationProperties.Name="Show Media Bar" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Clear History on Quit"
                                              Subtitle="Delete local clipboard history when Coworker quits">
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" IsOn="{x:Bind ViewModel.ClearHistoryOnQuit, Mode=TwoWay}"
                                                     AutomationProperties.Name="Clear History on Quit" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Maximum Items"
                                              Subtitle="Choose how many clipboard entries Coworker keeps locally">
                            <ComboBox x:Name="MaxItemsCombo" Width="120" SelectionChanged="OnMaxItemsChanged"
                                      AutomationProperties.Name="Maximum Items" />
                        </settings:SettingsRow>
                        <settings:SettingsRow Title="Clipboard Shortcut"
                                              Subtitle="Set the shortcut for the clipboard history panel">
                            <settings:ShortcutRecorder x:Name="ClipboardRecorder"
                                                       AutomationProperties.Name="Clipboard shortcut"
                                                       ShortcutRecorded="OnClipboardShortcutRecorded" />
                        </settings:SettingsRow>

                        <Button Style="{StaticResource SettingsActionButtonStyle}" Click="OnOpenClipboardPanel"
                                IsEnabled="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE77F;" FontSize="16" />
                                <TextBlock Text="Open Clipboard Panel" FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                   Text="Clipboard history stays local and is not synced to the Coworker database." />
                    </StackPanel>
                </settings:SettingsSection>

                <!-- SLOT (OpenRouter slice): the "OpenRouter" <settings:SettingsSection> goes here. -->

                <settings:SettingsSection Title="Model &amp; Language">
                    <StackPanel Spacing="16">
                        <controls:TranscriptionModelPicker Margin="0,4" />
                        <settings:SettingsRow Title="Language">
                            <ComboBox x:Name="LanguageCombo" Width="200" DisplayMemberPath="Name"
                                      SelectedValuePath="Code" SelectionChanged="OnLanguageChanged"
                                      AutomationProperties.Name="Language" />
                        </settings:SettingsRow>
                        <!-- SLOT (local transcription slice): the "Local transcription" and
                             "Benchmark engines" rows go here. -->
                    </StackPanel>
                </settings:SettingsSection>

                <settings:SettingsSection Title="Audio Quality">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                   Text="Choose how recordings are saved on disk and uploaded to your transcription history. Live transcription always streams at 16 kHz to keep latency low — this only affects the saved file." />
                        <StackPanel x:Name="AudioQualityPanel" Spacing="8" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;" FontSize="11"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="New setting takes effect on the next recording." FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </settings:SettingsSection>

                <!-- Tools: only shown once the screen-context feature registers SettingsPageHooks.CaptureScreenContext. -->
                <settings:SettingsSection x:Name="ToolsSection" Title="Tools" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <Button Style="{StaticResource SettingsActionButtonStyle}" Click="OnCapture">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7B3;" FontSize="16" />
                                <TextBlock Text="Capture" FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </settings:SettingsSection>

                <settings:SettingsSection Title="App Actions">
                    <StackPanel Spacing="12">
                        <Button x:Name="CheckForUpdatesButton" Style="{StaticResource SettingsActionButtonStyle}"
                                Click="OnCheckForUpdates">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="16" />
                                <TextBlock Text="Check for Updates" FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsActionButtonStyle}" Click="OnRestart">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                <TextBlock Text="Restart" FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsActionButtonStyle}" Click="OnResetOnboarding">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="16" />
                                <TextBlock Text="Reset Onboarding" FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsActionButtonStyle}" Click="OnQuit">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="#FFFF3B30" />
                                <TextBlock Text="Quit" FontSize="14" FontWeight="Medium" Foreground="#FFFF3B30" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </settings:SettingsSection>

                <settings:SettingsSection Title="Diagnostics">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Verbose logging" FontSize="13" FontWeight="Medium" />
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Write detailed logs to the Coworker logs folder for troubleshooting. Off by default — turn on only when reproducing a bug, since logs may include transcript text and device identifiers." />
                            </StackPanel>
                            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" Grid.Column="1" VerticalAlignment="Top"
                                                     IsOn="{x:Bind ViewModel.VerboseLogging, Mode=TwoWay}"
                                                     AutomationProperties.Name="Verbose logging" />
                        </Grid>
                        <Button Style="{StaticResource SettingsActionButtonStyle}" Click="OnOpenLogsFolder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                                <TextBlock Text="Open Logs Folder" FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </settings:SettingsSection>

                <settings:SettingsSection Title="About">
                    <Grid>
                        <TextBlock Text="Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" />
                    </Grid>
                </settings:SettingsSection>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
