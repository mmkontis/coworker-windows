<Page
    x:Class="Coworker.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#14142973" Offset="0" />
                <GradientStop Color="Transparent" Offset="0.5" />
                <GradientStop Color="#082473F2" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="32,24,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Chat" FontSize="28" FontWeight="Bold" />
                <TextBlock x:Name="ScopeSubtitle" Text="AI-powered conversation" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <!-- Workspace + company scope (mirrors macOS Chat Hub top bar,
                 backed by GET /coworker/contexts → company_users memberships) -->
            <ComboBox x:Name="WorkspaceSelector" Grid.Column="1"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      MinWidth="130"
                      ToolTipService.ToolTip="Workspace"
                      SelectionChanged="OnWorkspaceChanged" />
            <ComboBox x:Name="CompanySelector" Grid.Column="2"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      MinWidth="150"
                      ToolTipService.ToolTip="Company"
                      SelectionChanged="OnCompanyChanged" />
            <ComboBox x:Name="ModelSelector" Grid.Column="3"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      MinWidth="180" />
            <Button Grid.Column="4" Click="OnNewChat" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="16"
                              Foreground="{StaticResource CwAccentBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Opacity="0.5" />

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Grid.Row="2"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="24">
            <Grid Width="80" Height="80" HorizontalAlignment="Center">
                <Ellipse>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#262473F2" Offset="0" />
                            <GradientStop Color="#144DD9FF" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <FontIcon Glyph="&#xE8F2;" FontSize="32">
                    <FontIcon.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource CwAccentColor}" Offset="0" />
                            <GradientStop Color="{StaticResource CwSecondaryColor}" Offset="1" />
                        </LinearGradientBrush>
                    </FontIcon.Foreground>
                </FontIcon>
            </Grid>
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Start a conversation" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Ask anything — Coworker is powered by AI" FontSize="15"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
            <Grid ColumnSpacing="12" RowSpacing="12" Margin="60,0"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Click="OnSuggestion"
                        Tag="Explain quantum computing in simple terms"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        CornerRadius="12" Padding="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA80;" FontSize="14"
                                  Foreground="{StaticResource CwAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Explain a concept" FontSize="13"
                                   FontWeight="Medium" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Click="OnSuggestion"
                        Tag="Help me write a professional email to my team"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        CornerRadius="12" Padding="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"
                                  Foreground="{StaticResource CwAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Help me write" FontSize="13"
                                   FontWeight="Medium" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Click="OnSuggestion"
                        Tag="Brainstorm 5 creative marketing strategies"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        CornerRadius="12" Padding="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE945;" FontSize="14"
                                  Foreground="{StaticResource CwAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Brainstorm ideas" FontSize="13"
                                   FontWeight="Medium" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Click="OnSuggestion"
                        Tag="Help me debug this code and explain what's wrong"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        CornerRadius="12" Padding="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE943;" FontSize="14"
                                  Foreground="{StaticResource CwAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Debug code" FontSize="13"
                                   FontWeight="Medium" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Messages -->
        <ScrollViewer x:Name="MessagesScroll" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <ItemsRepeater x:Name="MessagesRepeater" Margin="0,16,0,16" />
        </ScrollViewer>

        <!-- Input Bar -->
        <Grid Grid.Row="3" Padding="32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInput" PlaceholderText="Message Coworker..."
                     KeyDown="OnInputKeyDown"
                     CornerRadius="16" Padding="16,12"
                     AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="150" />
            <Button Grid.Column="1" Click="OnSend" Margin="12,0,0,0"
                    Width="36" Height="36" CornerRadius="18"
                    Padding="0" VerticalAlignment="Bottom">
                <Button.Background>
                    <SolidColorBrush Color="{StaticResource CwAccentColor}" />
                </Button.Background>
                <FontIcon Glyph="&#xE74A;" FontSize="16" Foreground="White" />
            </Button>
        </Grid>
    </Grid>
</Page>
