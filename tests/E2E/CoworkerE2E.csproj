<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end test of the real, published Coworker.exe on Windows: real key presses (SendInput), a voice
       played into a virtual microphone (VB-CABLE), the recording streamed to a fake Coworker server, the
       transcript pasted into Notepad and read back through UI Automation, with a screen recording.
       Run by .github/workflows/coworker-windows-e2e.yml; see README.md next to this file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Coworker.E2E</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="clips\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
