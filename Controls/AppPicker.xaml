<UserControl
    x:Class="Coworker.Controls.AppPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Coworker.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/VoiceCommandResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Mac MacAppPicker: a field-like button that opens a 320 wide searchable list of installed apps. -->
    <Button x:Name="TriggerButton" Style="{StaticResource CommandPlainButtonStyle}"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
            BorderBrush="{StaticResource CommandAccentStroke}" BorderThickness="1"
            CornerRadius="8" Padding="10,8" AutomationProperties.Name="App">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Image x:Name="TriggerImage" Width="18" Height="18" Visibility="Collapsed" />
                <FontIcon x:Name="TriggerIcon" Glyph="&#xECAA;" FontSize="12" HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PlaceholderText" Text="Pick a Windows app…" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="-3">
                <FontIcon Glyph="&#xE70E;" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <FontIcon Glyph="&#xE70D;" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Button.Flyout>
            <Flyout x:Name="PickerFlyout" Placement="Bottom" Opened="OnFlyoutOpened" Closed="OnFlyoutClosed">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="320" />
                        <Setter Property="MaxWidth" Value="320" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <Grid Width="320">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="12,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource CommandFlatTextBoxStyle}"
                                 PlaceholderText="Search installed apps…" FontSize="13" VerticalAlignment="Center"
                                 AutomationProperties.Name="Search installed apps" TextChanged="OnSearchChanged" />
                        <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource CommandPlainButtonStyle}"
                                Visibility="Collapsed" Click="OnClearClick" AutomationProperties.Name="Clear search">
                            <FontIcon Glyph="&#xEA39;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Grid.Row="2" Padding="12,6">
                        <Button Style="{StaticResource CommandPlainButtonStyle}" HorizontalAlignment="Left"
                                Click="OnBrowseClick" AutomationProperties.Name="Browse for a program">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="11" FontWeight="Medium" Foreground="{StaticResource CwAccentBrush}" />
                                <TextBlock Text="Browse…" FontSize="12" FontWeight="Medium" Foreground="{StaticResource CwAccentBrush}" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="BrowseSpinner" Width="14" Height="14" HorizontalAlignment="Right"
                                      IsActive="False" Visibility="Collapsed" />
                    </Grid>

                    <Border Grid.Row="3" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel x:Name="LoadingPanel" Grid.Row="4" Padding="0,28" Spacing="8" Visibility="Collapsed">
                        <ProgressRing Width="20" Height="20" IsActive="True" />
                        <TextBlock Text="Loading installed apps…" FontSize="11" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="EmptyPanel" Grid.Row="4" Padding="0,28" Spacing="8" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="EmptyText" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ScrollViewer x:Name="ListScroll" Grid.Row="4" MaxHeight="340">
                        <ItemsRepeater x:Name="AppsRepeater">
                            <DataTemplate x:DataType="models:AppOptionViewModel">
                                <StackPanel>
                                    <Border Height="1" Margin="44,0,0,0" Visibility="{x:Bind DividerVisibility}"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button Style="{StaticResource CommandPlainButtonStyle}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Background="{x:Bind RowBrush}"
                                            Tag="{x:Bind}" Click="OnAppClick" Padding="12,6"
                                            AutomationProperties.Name="{x:Bind Name}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="10" MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold"
                                                      Foreground="{StaticResource CwAccentBrush}" VerticalAlignment="Center"
                                                      Visibility="{x:Bind CheckVisibility}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
