<UserControl
    x:Class="Coworker.Controls.SidebarRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A navigation row (Mac sidebarTabButton): icon 16 in a 24 column, label 14 medium, a 3x16
         capsule while selected, padding 16x10, radius 10. Selected and unselected text are two stacked
         layers that cross-fade (Mac: easeInOut 0.2). -->
    <Button x:Name="RowButton" Style="{StaticResource SidebarPlainButtonStyle}" Click="OnClick">
        <Grid>
            <Border x:Name="SelectedFill" Background="{StaticResource SidebarSelectedFill}" CornerRadius="10" Opacity="0" />
            <Grid Padding="16,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconSecondary" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="IconPrimary" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                        AutomationProperties.AccessibilityView="Raw" />

                <TextBlock x:Name="LabelSecondary" Grid.Column="1" FontSize="14" FontWeight="Medium"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"
                           Foreground="{StaticResource SidebarSecondaryText}" />
                <TextBlock x:Name="LabelPrimary" Grid.Column="1" FontSize="14" FontWeight="Medium"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"
                           Foreground="{StaticResource SidebarPrimaryText}" Opacity="0"
                           AutomationProperties.AccessibilityView="Raw" />

                <Border x:Name="Capsule" Grid.Column="2" Width="3" Height="16" CornerRadius="1.5"
                        Background="{StaticResource SidebarCapsuleBrush}" VerticalAlignment="Center" Opacity="0" />
            </Grid>
        </Grid>
    </Button>
</UserControl>
