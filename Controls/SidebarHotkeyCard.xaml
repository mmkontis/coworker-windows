<UserControl
    x:Class="Coworker.Controls.SidebarHotkeyCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Above the account row: the dictation shortcut as key caps (Mac SidebarHotkeyCard). Radius 8,
         padding 10, hairline stroke, small shadow. A click opens the Shortcuts dialog, one row per mode. -->
    <Grid>
        <Border x:Name="CardShadow" />
        <Button x:Name="CardButton" Style="{StaticResource SidebarPickerButtonStyle}" Padding="10" MinHeight="0" CornerRadius="8"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnClick"
                AutomationProperties.Name="Shortcuts" AutomationProperties.AutomationId="sidebar-hotkey-card">
            <Grid Height="28" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE720;" FontSize="14" Foreground="{StaticResource SidebarMutedText}" VerticalAlignment="Center" />
                <StackPanel x:Name="Caps" Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" />
                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="9" Foreground="{StaticResource SidebarMutedText}" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
