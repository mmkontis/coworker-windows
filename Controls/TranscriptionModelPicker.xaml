<UserControl
    x:Class="Coworker.Controls.TranscriptionModelPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Coworker.Controls">

    <StackPanel Spacing="14">
        <!-- Model: the full model list as a borderless menu -->
        <Grid>
            <TextBlock Text="Model" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
            <Button x:Name="MenuButton" HorizontalAlignment="Right" Padding="8,4"
                    Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="All transcription models"
                    AutomationProperties.AutomationId="transcription-model-menu">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock x:Name="SelectedNameText" FontSize="12" FontWeight="Medium"
                               MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="ModelMenu" Placement="BottomEdgeAlignedRight" Opening="OnMenuOpening" />
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Four-stop capsule slider: 44 pt track, 34 pt knob, 6 pt stop dots -->
        <controls:StopSliderSurface x:Name="Slider" Height="44" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" Padding="0"
                                    AutomationProperties.Name="Transcription model"
                                    AutomationProperties.AutomationId="transcription-model-stages"
                                    SizeChanged="OnSliderSizeChanged"
                                    PointerPressed="OnSliderPointerPressed"
                                    PointerMoved="OnSliderPointerMoved"
                                    PointerReleased="OnSliderPointerReleased"
                                    PointerCanceled="OnSliderPointerReleased"
                                    PointerCaptureLost="OnSliderPointerReleased"
                                    KeyDown="OnSliderKeyDown">
            <Grid>
                <Border CornerRadius="22" Background="{ThemeResource SettingsSliderTrack}" />
                <Border x:Name="FillCapsule" CornerRadius="22" HorizontalAlignment="Left"
                        Background="{StaticResource CwAccentBrush}" Visibility="Collapsed" />
                <Canvas x:Name="StopCanvas">
                    <Ellipse x:Name="Dot0" Width="6" Height="6" Fill="{ThemeResource SettingsSliderDot}" />
                    <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{ThemeResource SettingsSliderDot}" />
                    <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{ThemeResource SettingsSliderDot}" />
                    <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{ThemeResource SettingsSliderDot}" />
                    <Ellipse x:Name="KnobShadow" Width="36" Height="36" Fill="#1F000000" Visibility="Collapsed" />
                    <Ellipse x:Name="Knob" Width="34" Height="34" Fill="White" Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </controls:StopSliderSurface>

        <!-- Stop labels under the dots -->
        <Canvas x:Name="LabelCanvas" Height="18" />
    </StackPanel>
</UserControl>
