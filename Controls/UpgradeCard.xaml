<UserControl
    x:Class="Coworker.Controls.UpgradeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mac UpgradeWindowView: 320 wide, radius 16, a hairline stroke; icon 64 (radius 14), title 18 bold,
         optional usage line, message 13, and a 44 high footer split into "Not Now" and the action. -->
    <Grid Width="320" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource PopoverStroke}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <StackPanel Padding="28,28,28,24" Spacing="20">
            <Border Width="64" Height="64" CornerRadius="14" Margin="0,8,0,0" HorizontalAlignment="Center">
                <Image Source="ms-appx:///Assets/coworker-icon.png" Stretch="UniformToFill" />
            </Border>

            <StackPanel Spacing="6">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                <StackPanel x:Name="UsageRow" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="UsageText" FontSize="12" FontWeight="SemiBold" Foreground="#FFFF9F0A" />
                    <TextBlock Text="transcriptions used today" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="MessageText" FontSize="13" LineHeight="17" TextWrapping="Wrap" TextAlignment="Center" Margin="8,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource PopoverStroke}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource PopoverRowButtonStyle}" CornerRadius="0" HorizontalContentAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" Click="OnNotNow"
                    AutomationProperties.Name="Not Now" AutomationProperties.AutomationId="upgrade-not-now">
                <TextBlock Text="Not Now" FontSize="13" FontWeight="Medium" />
            </Button>
            <Border Grid.Column="1" Background="{ThemeResource PopoverStroke}" />
            <Button x:Name="ActionButton" Grid.Column="2" Style="{StaticResource PopoverRowButtonStyle}" CornerRadius="0"
                    HorizontalContentAlignment="Center" Foreground="{StaticResource CwAccentBrush}" Click="OnAction"
                    AutomationProperties.AutomationId="upgrade-action">
                <TextBlock x:Name="ActionText" FontSize="13" FontWeight="SemiBold" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
