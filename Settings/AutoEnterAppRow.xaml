<UserControl
    x:Class="Coworker.Settings.AutoEnterAppRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Coworker.Settings">

    <Border CornerRadius="10" Padding="10" Background="{ThemeResource SettingsInsetFill}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="28" Height="28" CornerRadius="6" Background="#1A808080" VerticalAlignment="Center">
                <Grid>
                    <FontIcon x:Name="PlaceholderIcon" Glyph="&#xE71D;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Image x:Name="AppIcon" Stretch="Uniform" Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="UsageText" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" x:Name="EnabledToggle" Grid.Column="2" VerticalAlignment="Center"
                                     Toggled="OnToggled" />
        </Grid>
    </Border>
</UserControl>
