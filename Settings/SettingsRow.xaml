<UserControl
    x:Class="Coworker.Settings.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="16" Padding="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Style="{StaticResource SettingsRowTitleStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource SettingsRowSubtitleStyle}"
                       Visibility="Collapsed" />
        </StackPanel>

        <ContentPresenter x:Name="TrailingHost" Grid.Column="1" VerticalAlignment="Center" />
    </Grid>
</UserControl>
