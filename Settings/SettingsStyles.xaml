<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings page tokens and styles. Merged into Application.Resources on first use
         (SettingsResources.EnsureLoaded) so the Settings UserControls and TranscriptionModelPicker
         resolve them wherever they are hosted. Values: Mac SettingsSection / SettingsRow /
         ThemeOptionCard / AudioQualityOptionRow (Components.swift, SettingsPageView.swift). -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- controlBackgroundColor at 60 percent -->
            <SolidColorBrush x:Key="SettingsCardFill" Color="#99FFFFFF" />
            <!-- textBackgroundColor at 70 percent -->
            <SolidColorBrush x:Key="SettingsInsetFill" Color="#B3FFFFFF" />
            <!-- primary at 3, 5, 6 and 8 percent -->
            <SolidColorBrush x:Key="SettingsOptionFill" Color="#08000000" />
            <SolidColorBrush x:Key="SettingsOptionHoverFill" Color="#0D000000" />
            <SolidColorBrush x:Key="SettingsInsetStroke" Color="#0F000000" />
            <SolidColorBrush x:Key="SettingsOptionStroke" Color="#14000000" />
            <!-- primary at 12 and 30 percent: model slider track and stop dots -->
            <SolidColorBrush x:Key="SettingsSliderTrack" Color="#1F000000" />
            <SolidColorBrush x:Key="SettingsSliderDot" Color="#4D000000" />
            <SolidColorBrush x:Key="SettingsRecorderFill" Color="#FFFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SettingsCardFill" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="SettingsInsetFill" Color="#B31C1C1C" />
            <SolidColorBrush x:Key="SettingsOptionFill" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="SettingsOptionHoverFill" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="SettingsInsetStroke" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SettingsOptionStroke" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SettingsSliderTrack" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="SettingsSliderDot" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="SettingsRecorderFill" Color="#FF2B2B2B" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- cwGlow at 15 percent -->
    <SolidColorBrush x:Key="SettingsCardStroke" Color="#26B3D9FF" />
    <!-- cwAccent at 8, 10, 40 and 50 percent -->
    <SolidColorBrush x:Key="SettingsAccentTint" Color="#142473F2" />
    <SolidColorBrush x:Key="SettingsAccentFill" Color="#192473F2" />
    <SolidColorBrush x:Key="SettingsAccentStrokeSoft" Color="#662473F2" />
    <SolidColorBrush x:Key="SettingsAccentStroke" Color="#802473F2" />
    <SolidColorBrush x:Key="SettingsRecorderStroke" Color="#4D808080" />

    <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="38" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource SettingsCardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource SettingsCardStroke}" />
    </Style>

    <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsRowSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SettingsNoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- A switch without the On/Off caption (Mac: Toggle(.switch)). The page fills it with the brand accent. -->
    <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <!-- The template keeps a 154 px minimum for the caption; the switch itself is 44 px wide. -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Bordered, regular-size, full-width action button: icon and label left-aligned, no chevron. -->
    <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Selection card: a RadioButton drawn as a rounded tile (theme cards). -->
    <Style x:Key="SettingsOptionCardStyle" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" CornerRadius="12" BorderThickness="1"
                          Background="{ThemeResource SettingsOptionFill}"
                          BorderBrush="{ThemeResource SettingsOptionStroke}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource SettingsAccentTint}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource SettingsAccentStroke}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="HoverLayer" CornerRadius="12" Opacity="0"
                                Background="{ThemeResource SettingsOptionHoverFill}" />
                        <ContentPresenter Padding="12"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Audio quality row: radius 10, inset fill and a softer selected stroke. -->
    <Style x:Key="SettingsAudioOptionStyle" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" CornerRadius="10" BorderThickness="1"
                          Background="{ThemeResource SettingsInsetFill}"
                          BorderBrush="{ThemeResource SettingsInsetStroke}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource SettingsAccentTint}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource SettingsAccentStrokeSoft}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Padding="12"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
