<UserControl
    x:Class="Coworker.Settings.PermissionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource SettingsCardStyle}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" VerticalAlignment="Center">
                <Ellipse Fill="{StaticResource SettingsAccentFill}" />
                <FontIcon x:Name="IconGlyph" FontSize="18" Foreground="{StaticResource CwAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText" Style="{StaticResource SettingsRowSubtitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="ActionButton" Click="OnActionClick" HorizontalAlignment="Right"
                        Padding="12,6" CornerRadius="8" BorderThickness="0" MinHeight="0" MinWidth="0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ActionText" FontSize="11" FontWeight="Medium" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
