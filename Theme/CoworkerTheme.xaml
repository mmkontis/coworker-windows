<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors matching macOS Coworker exactly -->
    <!-- cwAccent: sRGB(0.14, 0.45, 0.95) = #2473F2 -->
    <Color x:Key="CwAccentColor">#FF2473F2</Color>
    <!-- cwSecondary: sRGB(0.30, 0.85, 1.0) = #4DD9FF -->
    <Color x:Key="CwSecondaryColor">#FF4DD9FF</Color>
    <!-- cwDeep: sRGB(0.08, 0.16, 0.45) = #142973</Color> -->
    <Color x:Key="CwDeepColor">#FF142973</Color>
    <!-- cwBackground: sRGB(0.96, 0.97, 1.0, 0.92) -->
    <Color x:Key="CwBackgroundColor">#EBF5F8FF</Color>
    <!-- cwGlow: sRGB(0.70, 0.85, 1.0) = #B3D9FF -->
    <Color x:Key="CwGlowColor">#FFB3D9FF</Color>
    <!-- Sidebar bottom gradient: sRGB(0.06, 0.10, 0.30) = #0F1A4D -->
    <Color x:Key="CwSidebarBottomColor">#FF0F1A4D</Color>

    <SolidColorBrush x:Key="CwAccentBrush" Color="{StaticResource CwAccentColor}" />
    <SolidColorBrush x:Key="CwSecondaryBrush" Color="{StaticResource CwSecondaryColor}" />
    <SolidColorBrush x:Key="CwDeepBrush" Color="{StaticResource CwDeepColor}" />
    <SolidColorBrush x:Key="CwBackgroundBrush" Color="{StaticResource CwBackgroundColor}" />
    <SolidColorBrush x:Key="CwGlowBrush" Color="{StaticResource CwGlowColor}" />

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource CwDeepColor}" Offset="0.0" />
        <GradientStop Color="#F2142973" Offset="0.5" />
        <GradientStop Color="{StaticResource CwSidebarBottomColor}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UserBubbleGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource CwAccentColor}" Offset="0.0" />
        <GradientStop Color="#E62473F2" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource CwSecondaryColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource CwAccentColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Theme-dependent sidebar brushes. ThemeService rewrites these objects in place from
         CleanTheme.xaml / AuroraTheme.xaml (when the theme or the OS light/dark mode changes), so
         every reference restyles live. The values below are Clean, light. -->
    <LinearGradientBrush x:Key="SidebarSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF3F3F6" Offset="0.0" />
        <GradientStop Color="#FFF3F3F6" Offset="0.5" />
        <GradientStop Color="#FFF3F3F6" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#14000000" />
    <SolidColorBrush x:Key="SidebarPrimaryText" Color="#E4000000" />
    <SolidColorBrush x:Key="SidebarSecondaryText" Color="#9E000000" />
    <SolidColorBrush x:Key="SidebarMutedText" Color="#6E000000" />
    <SolidColorBrush x:Key="SidebarDivider" Color="#14000000" />
    <SolidColorBrush x:Key="SidebarNeutralFill" Color="#0F000000" />
    <SolidColorBrush x:Key="SidebarHoverFill" Color="#0D000000" />
    <SolidColorBrush x:Key="SidebarSelectedFill" Color="#0F000000" />
    <SolidColorBrush x:Key="SidebarCapsuleBrush" Color="#FF2473F2" />

    <!-- Typography - matching macOS system font sizes -->
    <x:Double x:Key="HeaderFontSize">32</x:Double>
    <x:Double x:Key="SubheaderFontSize">22</x:Double>
    <x:Double x:Key="TitleFontSize">16</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="SmallCaptionFontSize">11</x:Double>
    <x:Double x:Key="TinyCaptionFontSize">10</x:Double>

    <!-- Corner Radii matching macOS -->
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="MetricCardCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="BubbleCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="SidebarItemCornerRadius">10</CornerRadius>

    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="MetricCardPadding">20</Thickness>
</ResourceDictionary>
