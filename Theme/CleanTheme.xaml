<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Clean (Mac default): system light/dark neutrals. A palette, not merged into the app: ThemeService
         copies these values into the live brushes declared in CoworkerTheme.xaml (same keys), which is
         what lets already-open pages restyle. Values: ThemeManager.swift / SidebarView.swift, audit 01-shell.md section 6. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="SidebarSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF3F3F6" Offset="0.0" />
                <GradientStop Color="#FFF3F3F6" Offset="0.5" />
                <GradientStop Color="#FFF3F3F6" Offset="1.0" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SidebarPrimaryText" Color="#E4000000" />
            <SolidColorBrush x:Key="SidebarSecondaryText" Color="#9E000000" />
            <SolidColorBrush x:Key="SidebarMutedText" Color="#6E000000" />
            <SolidColorBrush x:Key="SidebarDivider" Color="#14000000" />
            <SolidColorBrush x:Key="SidebarNeutralFill" Color="#0F000000" />
            <SolidColorBrush x:Key="SidebarHoverFill" Color="#0D000000" />
            <SolidColorBrush x:Key="SidebarSelectedFill" Color="#0F000000" />
            <SolidColorBrush x:Key="SidebarCapsuleBrush" Color="#FF2473F2" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="SidebarSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1E1E21" Offset="0.0" />
                <GradientStop Color="#FF1E1E21" Offset="0.5" />
                <GradientStop Color="#FF1E1E21" Offset="1.0" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SidebarPrimaryText" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SidebarSecondaryText" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="SidebarMutedText" Color="#8AFFFFFF" />
            <SolidColorBrush x:Key="SidebarDivider" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SidebarNeutralFill" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SidebarHoverFill" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="SidebarSelectedFill" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SidebarCapsuleBrush" Color="#FF2473F2" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
