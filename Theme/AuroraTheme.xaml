<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Aurora: the deep-blue gradient sidebar with white text, identical in light and dark. A palette
         copied into the live brushes of CoworkerTheme.xaml by ThemeService. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <LinearGradientBrush x:Key="SidebarSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF142973" Offset="0.0" />
                <GradientStop Color="#F2142973" Offset="0.5" />
                <GradientStop Color="#FF0F1A4D" Offset="1.0" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SidebarPrimaryText" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SidebarSecondaryText" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="SidebarMutedText" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="SidebarDivider" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SidebarNeutralFill" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SidebarHoverFill" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="SidebarSelectedFill" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SidebarCapsuleBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
